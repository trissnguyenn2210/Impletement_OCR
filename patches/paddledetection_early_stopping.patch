         pass
 
 
+class EarlyStopping(Callback):
+    """Stop training when validation bbox mAP@[0.50:0.95] stops improving."""
+
+    def __init__(self, model):
+        super(EarlyStopping, self).__init__(model)
+        self.patience = int(self.model.cfg.get('early_stopping_patience', 0))
+        self.min_delta = float(
+            self.model.cfg.get('early_stopping_min_delta', 0.0))
+        self.best_map = float('-inf')
+        self.bad_evals = 0
+
+    def on_step_end(self, status):
+        pass
+
+    def _validation_map(self):
+        for metric in self.model._metrics:
+            results = metric.get_results()
+            bbox_stats = results.get('bbox') if isinstance(results, dict) else None
+            if bbox_stats is not None and len(bbox_stats) > 0:
+                return float(bbox_stats[0])
+        return None
+
+    def on_epoch_end(self, status):
+        if self.patience <= 0 or status.get('mode') != 'eval':
+            return
+        if dist.get_world_size() > 1 and dist.get_rank() != 0:
+            return
+
+        validation_map = self._validation_map()
+        if validation_map is None:
+            self.logger.warning(
+                'Early stopping skipped: validation bbox mAP was not available for epoch %s.',
+                status.get('epoch_id', '?'))
+            return
+
+        improved = validation_map > self.best_map + self.min_delta
+        if improved:
+            self.best_map = validation_map
+            self.bad_evals = 0
+        else:
+            self.bad_evals += 1
+
+        epoch_number = int(status.get('epoch_id', 0)) + 1
+        self.logger.info(
+            'Early stopping: epoch %s val mAP@[0.50:0.95]=%.6f, best=%.6f, '
+            'patience=%s/%s', epoch_number, validation_map, self.best_map,
+            self.bad_evals, self.patience)
+        if self.bad_evals >= self.patience:
+            status['early_stop'] = True
+            self.logger.info(
+                'Early stopping triggered after %s validations without mAP improvement.',
+                self.patience)
+
+
 class ComposeCallback(object):
     def __init__(self, callbacks):
         callbacks = [c for c in list(callbacks) if c is not None]
